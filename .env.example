NODE_ENV=development
DATABASE_URL=postgresql://arremataflow_app:generated-password@127.0.0.1:5432/arremataflow
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:8081
APP_PUBLIC_URL=http://127.0.0.1:8081
DATABASE_SSL=false
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_EMAIL_FROM=ArremataFlow <acesso@seudominio.com.br>
EMAIL_PROVIDER=resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_ENFORCEMENT_ENABLED=true
# Quantidade de proxies reversos confiáveis à frente do app (ex.: 1 com Caddy/Nginx). 0 ignora x-forwarded-for.
TRUSTED_PROXY_HOPS=0
DOCUMENT_STORAGE_PATH=.data/documents
MEDIA_CAPACITY_GB=100
